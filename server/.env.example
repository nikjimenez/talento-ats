# ═══════════════════════════════════════════════════════════════
# Server environment variables.
# Copy to .env and fill in. NEVER commit .env to the repository.
#
# Columns: DEV = needed to run locally · PROD = needed in production
# ═══════════════════════════════════════════════════════════════

# ── Phase 1 · Database ──
# DEV: required · PROD: required
# Postgres connection string. Create the database with `createdb talento_ats`.
DATABASE_URL=postgres://user:password@localhost:5432/talento_ats

# DEV: optional · PROD: recommended — max pooled connections (default 10)
PG_POOL_MAX=10

# Password for the initial administrator that `npm run seed` creates.
# DEV: required once · PROD: required once, then change it from the app.
# If it is missing, seed.js warns and does not create the user.
SEED_ADMIN_PASSWORD=

# ── Phase 2 · Sessions ──
# DEV: optional (falls back to an insecure default) · PROD: REQUIRED
# Signs document links and derives the storage HMAC. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# DEV: optional · PROD: optional — session lifetime and lockout policy
SESSION_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── CV extractor (Python service) ──
# DEV: optional · PROD: optional
# If it is not running the application still works: the form opens empty
# and the recruiter types the data in by hand.
EXTRACTOR_URL=http://127.0.0.1:8100
EXTRACTOR_TIMEOUT_MS=20000

# ── Phase 6 · Document storage ──
# DEV: optional — without them files are written to ./.storage on disk
# PROD: required — swap services/storage.js `driver` for S3/R2/GCS
STORAGE_PATH=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Phase 7 · Google Calendar ──
# Obtained from: Google Cloud console → APIs & Services → Credentials →
# OAuth client ID (Web application).
# Scopes used: calendar.events, userinfo.email
# The redirect URI must match GOOGLE_REDIRECT_URI character for character.
# DEV: optional (scheduling returns a clear "not configured" error)
# PROD: required for interview scheduling
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# ── Phase 7 · WhatsApp Business (Meta Cloud API) ──
# Obtained from: Meta for Developers → your app → WhatsApp → API setup.
# The seven templates must be APPROVED in the Meta console under the same
# names services/whatsapp.js declares. Approval takes hours to days.
# DEV: optional (sends are logged as failed, with their preview)
# PROD: required for candidate messaging
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Phase 7 · Occupational medical exam ──
# No standard API exists in Colombia: the name is used on the request and
# the result is recorded by hand. If the client's provider offers an
# integration, hook it into services/medical.js.
# DEV: optional · PROD: optional
MEDICAL_PROVIDER=Occupational Health Provider

# ── Phase 7 · Electronic signature ──
# Obtained from: your e-signature provider's console (must have legal
# standing in Colombia). Without it, offers go out for manual signature
# and the recruiter records the answer — the flow still works.
# DEV: optional · PROD: optional
SIGNATURE_PROVIDER=
SIGNATURE_API_URL=
SIGNATURE_API_KEY=

# ── Third-party credential encryption ──
# DEV: optional (falls back to SESSION_SECRET) · PROD: REQUIRED
# Without it, Google tokens would sit in the database in clear text.
# lib/crypto.js throws on boot in production if it is missing.
# Generate with: openssl rand -base64 32
INTEGRATION_KEY=

# ── HTTP ──
# DEV: optional · PROD: required
# Frontend origin, used for CORS and for OAuth redirects. In production
# the frontend should sit on the same origin as the API, because the
# session cookie is SameSite=Strict.
CORS_ORIGIN=http://localhost:8080

# DEV: optional · PROD: set by the platform — HTTP port (default 3000)
PORT=3000

# DEV: leave unset · PROD: set to `production`
# Enables Secure cookies and makes INTEGRATION_KEY mandatory.
NODE_ENV=
